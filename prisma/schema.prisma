generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  passwordHash   String
  slug           String   @unique
  timezone       String   @default("America/New_York")
  workingHours   String   @default("{\"mon\":{\"enabled\":true,\"start\":\"09:00\",\"end\":\"17:00\"},\"tue\":{\"enabled\":true,\"start\":\"09:00\",\"end\":\"17:00\"},\"wed\":{\"enabled\":true,\"start\":\"09:00\",\"end\":\"17:00\"},\"thu\":{\"enabled\":true,\"start\":\"09:00\",\"end\":\"17:00\"},\"fri\":{\"enabled\":true,\"start\":\"09:00\",\"end\":\"17:00\"},\"sat\":{\"enabled\":false,\"start\":\"09:00\",\"end\":\"17:00\"},\"sun\":{\"enabled\":false,\"start\":\"09:00\",\"end\":\"17:00\"}}")
  bufferMinutes      Int      @default(0)
  blockSyncWindowDays Int     @default(60)
  zoomAccessToken    String?
  zoomRefreshToken   String?
  zoomTokenExpiresAt DateTime?
  createdAt          DateTime @default(now())

  calendarAccounts CalendarAccount[]
  meetingTypes     MeetingType[]
  bookings         Booking[]
  mirroredBlocks   MirroredBlock[]
}

model CalendarAccount {
  id           String   @id @default(cuid())
  userId       String
  provider     String
  accountEmail String
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  isMain       Boolean  @default(false)
  mainCalId    String?
  watchCalIds  String   @default("[]")
  mirrorCalIds String   @default("[]")
  createdAt    DateTime @default(now())

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings         Booking[]
  mirrorsAsSource  MirroredBlock[] @relation("MirrorSource")
  mirrorsAsTarget  MirroredBlock[] @relation("MirrorTarget")

  @@unique([userId, accountEmail, provider])
}

// Tracks "Busy" placeholder events written to a Main calendar to mirror
// events from other watched calendars. Kept independent of Booking/MeetingType
// so this sync feature can be extracted as a standalone product later.
model MirroredBlock {
  id              String   @id @default(cuid())
  userId          String
  sourceAccountId String
  sourceCalId     String
  sourceEventId   String
  sourceUpdatedAt String
  startTime       DateTime
  endTime         DateTime
  allDay          Boolean  @default(false)
  mainAccountId   String
  mainEventId     String
  createdAt       DateTime @default(now())

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceAccount CalendarAccount @relation("MirrorSource", fields: [sourceAccountId], references: [id], onDelete: Cascade)
  mainAccount   CalendarAccount @relation("MirrorTarget", fields: [mainAccountId], references: [id], onDelete: Cascade)

  @@unique([sourceAccountId, sourceCalId, sourceEventId])
}

model MeetingType {
  id              String   @id @default(cuid())
  userId          String
  name            String
  slug            String
  durationMinutes Int      @default(30)
  description     String?
  isActive        Boolean  @default(true)
  color           String   @default("#3B82F6")
  locationOptions String   @default("[]")    // JSON: [{type, value, label}]
  createdAt       DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@unique([userId, slug])
}

model Booking {
  id                String   @id @default(cuid())
  meetingTypeId     String
  userId            String
  calendarAccountId String?
  bookerName        String
  bookerEmail       String
  notes             String?
  startTime         DateTime
  endTime           DateTime
  calendarEventId   String?
  conferenceLink    String?
  status            String   @default("confirmed")
  createdAt         DateTime @default(now())

  meetingType     MeetingType      @relation(fields: [meetingTypeId], references: [id])
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  calendarAccount CalendarAccount? @relation(fields: [calendarAccountId], references: [id])
}
